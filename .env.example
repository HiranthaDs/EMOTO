APP_ENV=development
DATA_DIR=backend/data
SESSION_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_TOKEN=replace-with-a-one-time-random-token
SESSION_HOURS=12
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:10000
# Set this to the public HTTPS domain before sending document links or printing QR codes.
PUBLIC_BASE_URL=

# Vercel sets these from vercel.json. Its SQLite database and uploaded files are
# temporary and can disappear whenever a Function instance is replaced.
# APP_ENV=production
